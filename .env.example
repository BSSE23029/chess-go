# Copy this file to .env, edit the values, then load it in your shell:
#   set -a; . ./.env; set +a
# chess-go reads environment variables at startup; it does not auto-load dotenv files.

# Terminal and local identity
CHESS_THEME=unicode
CHESS_PIECE_STYLE=auto
CHESS_PLAYER_NAME=
CHESS_PLAYER_COLOR=white
CHESS_BOT_NAME=Bot
CHESS_CLOCK=
CHESS_INCREMENT=
NO_COLOR=

# Built-in bot
CHESS_BOT_DEPTH=3
CHESS_BOT_LEVEL=
CHESS_BOT_PERSONALITY=
CHESS_BOT_SEED=
CHESS_BOT_RANDOM=true

# Network client/server
CHESS_NETWORK_URL=https://127.0.0.1:8080
CHESS_NETWORK_ADDR=:8080
CHESS_NETWORK_TOKEN=
CHESS_NETWORK_FORMAT=json
CHESS_NETWORK_INSECURE=false
CHESS_MATCH_ID=
CHESS_PLAYER_ID=
CHESS_MATCH_STORE=

# TLS and LAN discovery
CHESS_TLS_CERT=
CHESS_TLS_KEY=
CHESS_TLS_CA=
CHESS_TLS_CLIENT_CERT=
CHESS_TLS_CLIENT_KEY=
CHESS_LAN_DISCOVERY=false
CHESS_LAN_INSTANCE=chess-go
CHESS_LAN_HOST=

# Tournament and optional external UCI engine
CHESS_TOURNAMENT_PROFILES=Learner,Beginner,Casual
CHESS_TOURNAMENT_GAMES=20
CHESS_TOURNAMENT_PLIES=300
CHESS_TOURNAMENT_SEED=
CHESS_UCI_ENGINE=
CHESS_UCI_NAME=UCI
CHESS_UCI_DEPTH=5
CHESS_ENGINE_VERSION=dev
CHESS_TOURNAMENT_NODE_BUDGET=
CHESS_TOURNAMENT_TIME_CONTROL=
CHESS_TOURNAMENT_HARDWARE=unspecified
