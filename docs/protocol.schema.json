{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chess-go.example/schema/protocol-v1.json",
  "title": "chess-go protocol v1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "payload"],
  "properties": {
    "version": {"const": 1},
    "type": {
      "enum": [
        "match.create", "match.join", "match.snapshot", "match.move",
        "match.move.accepted", "match.resign", "match.draw.offer", "error"
      ]
    },
    "request_id": {"type": "string"},
    "payload": {"type": "object"}
  },
  "$defs": {
    "create_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id"],
      "properties": {
        "match_id": {"type": "string", "minLength": 1},
        "initial_fen": {"type": "string"},
        "player_id": {"type": "string"},
        "color": {"enum": ["white", "black", "spectator"]}
      }
    },
    "join_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id", "player_id", "color"],
      "properties": {
        "match_id": {"type": "string", "minLength": 1},
        "player_id": {"type": "string", "minLength": 1},
        "color": {"enum": ["white", "black", "spectator"]}
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id", "player_id", "sequence", "position_hash", "uci"],
      "properties": {
        "match_id": {"type": "string", "minLength": 1},
        "player_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "position_hash": {"type": "integer", "minimum": 0},
        "uci": {"type": "string", "minLength": 4}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id"],
      "properties": {
        "match_id": {"type": "string", "minLength": 1},
        "player_id": {"type": "string"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id", "player_id"],
      "properties": {
        "match_id": {"type": "string", "minLength": 1},
        "player_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
